{
  "name": "lispnt",
  "displayName": "Lispnt",
  "version": "0.0.1",
  "private": true,
  "description": "Lispnt - a gentle, read-only diagnostic path for Common Lisp (SBCL), alongside OLIVE.",
  "license": "MIT",
  "main": "./dist/src/extension.js",
  "engines": {
    "vscode": "^1.147.0"
  },
  "activationEvents": [
    "onLanguage:lisp",
    "workspaceContains:**/*.lisp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lispnt.checkFile",
        "title": "Lispnt: Check File"
      },
      {
        "command": "lispnt.showTrace",
        "title": "Lispnt: Open Text Trace View",
        "icon": "$(output)"
      },
      {
        "command": "lispnt.pinTrace",
        "title": "Lispnt: Pin the Traced File (Widget Only)",
        "icon": "$(pin)"
      },
      {
        "command": "lispnt.unpinTrace",
        "title": "Lispnt: Unpin the Traced File (Widget Only)",
        "icon": "$(pinned)"
      },
      {
        "command": "lispnt.showValueHints",
        "title": "Lispnt: Show Value Hints (Widget Only)",
        "icon": "$(eye)"
      },
      {
        "command": "lispnt.hideValueHints",
        "title": "Lispnt: Hide Value Hints (Widget Only)",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lispnt.showTrace",
          "when": "view == lispnt.trace",
          "group": "navigation@1"
        },
        {
          "command": "lispnt.pinTrace",
          "when": "view == lispnt.trace && !lispnt.pinned",
          "group": "navigation@2"
        },
        {
          "command": "lispnt.unpinTrace",
          "when": "view == lispnt.trace && lispnt.pinned",
          "group": "navigation@2"
        },
        {
          "command": "lispnt.showValueHints",
          "when": "view == lispnt.trace && !lispnt.valueHints",
          "group": "navigation@3"
        },
        {
          "command": "lispnt.hideValueHints",
          "when": "view == lispnt.trace && lispnt.valueHints",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Lispnt",
      "properties": {
        "lispnt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check Lisp files and report mistakes in the Problems panel."
        },
        "lispnt.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "How long to wait after an edit before checking the file again."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lispnt",
          "title": "Lispnt",
          "icon": "media/lispnt.svg"
        }
      ]
    },
    "views": {
      "lispnt": [
        {
          "id": "lispnt.trace",
          "name": "Trace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lispnt.trace",
        "contents": "Open a Lisp file to see the calls its ;;[trace] markers name.\n[Show Trace](command:lispnt.showTrace)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "bench": "npm run build && node bench/run.mjs",
    "test": "npm run build && node dist/test/reader.test.js && node dist/test/analyze.test.js && node dist/test/interpreter.test.js && node dist/test/print.test.js && node dist/test/pipeline.test.js && node dist/test/bindings.test.js && node dist/test/scopes.test.js && node dist/test/name-checks.test.js && node dist/test/hints.test.js && node dist/test/trace.test.js && node dist/test/trace-cases.test.js && node dist/test/trace-tree.test.js && node dist/test/value-hints.test.js && node dist/test/extension.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "1.146.0",
    "typescript": "7.0.2"
  }
}
